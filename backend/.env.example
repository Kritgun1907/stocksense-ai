# StockSense AI — Environment Variables
# ────────────────────────────────────────────────────────────────────────────
# COPY THIS FILE: cp .env.example .env
# Then fill in real values. Never commit .env to git.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
# Local dev (no password, macOS brew default user = your system username):
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/stocksense
# Local dev with password:
# DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/stocksense
# Docker:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/stocksense

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── NewsAPI (for FinBERT sentiment analysis) ─────────────────────────────────
# Get a free key at: https://newsapi.org/register
NEWS_API_KEY=CHANGE_ME

# ── JWT Auth (for future user authentication) ───────────────────────────────
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
